# Copy to .env and fill in. All ADI_* settings live in backend/app/config.py.

# --- Claude (MEDIUM/DIFFICULT/fallback tiers) ---
ANTHROPIC_API_KEY=
# ADI_MODEL_OCR_LLM=claude-haiku-5-5
# ADI_MODEL_DOCUMENT_AI=claude-sonnet-5-5
# ADI_MODEL_FALLBACK=claude-opus-5-5

# --- Outlook via Microsoft Graph (app registration with Mail.Read application permission) ---
ADI_GRAPH_TENANT_ID=
ADI_GRAPH_CLIENT_ID=
ADI_GRAPH_CLIENT_SECRET=
ADI_GRAPH_MAILBOX=accounts@yourcompany.com
ADI_GRAPH_POLL_ENABLED=true
ADI_GRAPH_POLL_SECONDS=300

# --- Optional: Azure AI Document Intelligence as the DIFFICULT-tier engine ---
# ADI_AZURE_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# ADI_AZURE_DI_KEY=

# --- Tuning ---
# ADI_ACCEPT_CONFIDENCE=0.85
# ADI_MAX_COST_PER_DOCUMENT_USD=0.50
