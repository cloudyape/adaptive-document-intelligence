# Copy to .env and fill in. All ADI_* settings live in backend/app/config.py.

# --- Azure AI Document Intelligence (the only paid engine: tiers 3-5) ---
ADI_AZURE_DI_ENDPOINT=
ADI_AZURE_DI_KEY=
# Per-page prices in USD. These are placeholders - set them from your Azure pricing page / portal.
# ADI_AZURE_DI_READ_COST_PER_PAGE=0.0015
# ADI_AZURE_DI_INVOICE_COST_PER_PAGE=0.01
# ADI_AZURE_DI_HIGHRES_COST_PER_PAGE=0.006
# ADI_AZURE_DI_READ_ENABLED=true        # tier 3: Read OCR + rules before the invoice model
# ADI_AZURE_DI_HIGHRES_FALLBACK=true    # tier 5: invoice model + high-resolution OCR add-on
# Rate limits. Free F0 tier: ~20 requests/min (status checks count) and 4 MB per file. Raise these on S0.
# ADI_AZURE_DI_REQUESTS_PER_MINUTE=15
# ADI_AZURE_DI_POLL_SECONDS=3
# ADI_AZURE_DI_MAX_RETRIES=5            # retries 429 / 5xx / dropped connections (SSL EOF) with backoff
# ADI_AZURE_DI_MAX_FILE_MB=4

# --- Outlook via Microsoft Graph (app registration with Mail.Read application permission) ---
ADI_GRAPH_TENANT_ID=
ADI_GRAPH_CLIENT_ID=
ADI_GRAPH_CLIENT_SECRET=
ADI_GRAPH_MAILBOX=accounts@yourcompany.com
ADI_GRAPH_POLL_ENABLED=true
ADI_GRAPH_POLL_SECONDS=300

# --- Tuning ---
# ADI_ACCEPT_CONFIDENCE=0.85
# ADI_MAX_COST_PER_DOCUMENT_USD=0.25
# ADI_DB_HOST_PORT=5434                  # host port for psql/GUI access to the Docker Postgres
